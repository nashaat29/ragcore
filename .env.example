# RAGCORE CONFIGURATION
# Copy this to .env and adjust values

# --- LLM ---
RAGCORE_LLM_MODEL=frob/qwen3.5-instruct:9b
RAGCORE_LLM_BASE_URL=http://127.0.0.1:11434
RAGCORE_LLM_TEMPERATURE=0.0
RAGCORE_LLM_MAX_TOKENS=4096
RAGCORE_LLM_TIMEOUT=120

# --- Embeddings ---
RAGCORE_EMBEDDING_MODEL=nomic-embed-text:latest
RAGCORE_EMBEDDING_BASE_URL=http://127.0.0.1:11434

# --- Chunking ---
RAGCORE_CHUNK_MIN_TOKENS=200
RAGCORE_CHUNK_MAX_TOKENS=1200
RAGCORE_CHUNK_OVERLAP_TOKENS=150
RAGCORE_CHUNK_SIMILARITY_THRESHOLD=0.85

# --- Retrieval ---
RAGCORE_RETRIEVAL_STRATEGY=simple
RAGCORE_RETRIEVAL_TOP_K=4
RAGCORE_RETRIEVAL_SCORE_THRESHOLD=0.0

# --- Cache ---
RAGCORE_CACHE_EMBEDDING_TTL=86400
RAGCORE_CACHE_SEMANTIC_TTL=3600
RAGCORE_CACHE_SEMANTIC_THRESHOLD=0.92
RAGCORE_CACHE_LRU_MAXSIZE=4096
RAGCORE_CACHE_ENABLED=true

# --- Data ---
RAGCORE_DATA_DIR=./rag_data
RAGCORE_INDEX_NAME=default

# --- Logging ---
RAGCORE_LOG_LEVEL=INFO
RAGCORE_LOG_FORMAT=json
RAGCORE_LOG_FILE=./rag_data/logs/ragcore.log
RAGCORE_LOG_ROTATION=10MB
RAGCORE_LOG_RETENTION="30 days"

# --- Server ---
RAGCORE_SERVER_HOST=127.0.0.1
RAGCORE_SERVER_PORT=29000
RAGCORE_SERVER_RELOAD=false
RAGCORE_SERVER_WORKERS=1

# --- CORS ---
# For multiple origins: ["http://localhost:3000", "http://example.com"]
# Use ["*"] to allow all origins (not recommended for production)
RAGCORE_CORS_ALLOW_ORIGINS=["*"]
RAGCORE_CORS_ALLOW_METHODS=["*"]
RAGCORE_CORS_ALLOW_HEADERS=["*"]

# --- Rate Limiting ---
# Format: [count]/[interval] where interval: second, minute, hour, day
RAGCORE_RATE_LIMIT_ENABLED=true
RAGCORE_RATE_LIMIT_DEFAULT=100/minute
RAGCORE_RATE_LIMIT_QUERY=20/minute
RAGCORE_RATE_LIMIT_INGEST=10/minute

# --- Input Limits ---
RAGCORE_MAX_TEXT_LENGTH=100000
RAGCORE_MAX_FILE_SIZE_MB=50
RAGCORE_MAX_QUERY_LENGTH=4000
RAGCORE_MAX_K=50
